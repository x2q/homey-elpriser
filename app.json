            "type": "number",
            "title": {
              "en": "Hour",
              "da": "Time"
            },
            "example": 13
          }
        ],
        "id": "cheapest_hour_starts"
      },
      {
        "title": {
          "en": "The price rises above a value",
          "da": "Prisen stiger over en værdi"
        },
        "titleFormatted": {
          "en": "The price rises above [[threshold]]",
          "da": "Prisen stiger over [[threshold]]"
        },
        "hint": {
          "en": "Fires at the start of an hour when the price of that hour is above the value and the previous hour's was not. The value is in the zone's currency per kWh.",
          "da": "Udløses ved starten af en time, hvis timens pris er over værdien, og den forrige times pris ikke var. Værdien er i zonens valuta pr. kWh."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=zone"
          },
          {
            "name": "threshold",
            "type": "number",
            "placeholder": {
              "en": "1.50",
              "da": "1,50"
            },
            "step": 0.001,
            "min": -100,
            "max": 1000000
          }
        ],
        "tokens": [
          {
            "name": "price",
