  "flow": {
    "triggers": [
      {
        "title": {
          "en": "A cheap hour starts",
          "da": "En billig time starter"
        },
        "hint": {
          "en": "Fires at the start of an hour that is one of today's cheapest hours (the number is set in the device settings) when the previous hour was not.",
          "da": "Udløses ved starten af en time, der er en af dagens billigste (antallet angives i enhedens indstillinger), hvis den forrige time ikke var."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=zone"
          }
        ],
        "tokens": [
          {
            "name": "price",
            "type": "number",
            "title": {
              "en": "Price",
              "da": "Pris"
            },
            "example": 1.23
          },
          {
            "name": "hour",
            "type": "number",
            "title": {
              "en": "Hour",
              "da": "Time"
            },
            "example": 13
          }
        ],
        "id": "cheap_hour_starts"
      },
      {
        "title": {
          "en": "The cheapest hour of the day starts",
          "da": "Dagens billigste time starter"
        },
        "hint": {
          "en": "Fires once a day, at the start of the hour with the lowest price of today.",
          "da": "Udløses én gang om dagen, ved starten af den time med dagens laveste pris."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=zone"
          }
        ],
        "tokens": [
          {
            "name": "price",
            "type": "number",
            "title": {
              "en": "Price",
              "da": "Pris"
            },
            "example": 1.23
          },
          {
